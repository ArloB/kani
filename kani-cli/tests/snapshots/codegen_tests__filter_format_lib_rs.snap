    fn search_manga(
        &self,
        query: &str,
        page: i32,
        page_size: i32,
        filters: &[ActiveFilter],
    ) -> ExtensionResult<MangaList> {
        let mut req = HttpRequest::get(format!("{}/search", self.base_url)).query("q", query);

        for f in filters {
            let (group, action) = f
                .filter_name
                .split_once(':')
                .unwrap_or((&f.filter_name, ""));
            match group {
                "genres" => match &f.state {
                    FilterState::Checkbox(c) if *c => {
                        req = req.query("genre", if action.is_empty() { "1" } else { action });
                    }
                    FilterState::Checkbox(_) => {
                        req = req.query("genre", "0");
                    }
                    FilterState::Multiselect(values) => {
                        for v in values {
                            req = req.query("genre[]", v.as_str());
                        }
                    }
                    FilterState::Selection { value, .. } => {
                        req = req.query("genre", value.as_str())
                    }
                    FilterState::TextInput(s) => req = req.query("genre", s.as_str()),
                    _ => {}
                },
                "nsfw" => match &f.state {
                    FilterState::Checkbox(c) if *c => {
                        req = req.query("nsfw", if action.is_empty() { "1" } else { action });
                    }
                    FilterState::Checkbox(_) => {
                        req = req.query("nsfw", "0");
                    }
                    FilterState::Multiselect(values) => {
                        for v in values {
                            req = req.query("nsfw[]", v.as_str());
                        }
                    }
                    FilterState::Selection { value, .. } => req = req.query("nsfw", value.as_str()),
                    FilterState::TextInput(s) => req = req.query("nsfw", s.as_str()),
                    _ => {}
                },
                "year_range" => match &f.state {
                    FilterState::TextInput(s) => {
                        if let Some((from, to)) = s.split_once(':') {
                            req = req.query("year_from", from);
                            req = req.query("year_to", to);
                        }
                    }
                    _ => {}
                },
                _ => {}
            }
        }
        let bp = BlueprintBuilder::new(".results .item")
            .request(req)
            .field(
                "id",
                Expr::self_ref().first("a").attr("href").split("/").at(-1),
            )
            .field("title", Expr::self_ref().first(".title").text().trim())
            .build();
        let rows = extract::html(None, &bp)?;
        let has_next_page = false;
        let total_pages = None;
        let manga = rows
            .rows_iter()
            .filter_map(|row| {
                Some(MangaListItem {
                    id: row.require_str("/id").ok()?,
                    title: row.require_str("/title").ok()?,
                })
            })
            .collect();
        Ok(MangaList {
            manga,
            has_next_page,
            total_pages,
        })
    }

