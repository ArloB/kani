#!/bin/sh
# Check sqlx offline query cache is up to date before pushing.
# Mirrors the "Check sqlx offline data" step in ci.yml.
# Activate with: git config core.hooksPath .githooks

if ! command -v cargo-sqlx > /dev/null 2>&1; then
  echo "warning: sqlx-cli not found, skipping sqlx offline data check"
  echo "         Install with: cargo binstall sqlx-cli"
  exit 0
fi

# Only run when Rust files are part of this push.
HAS_RS=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip branch deletions.
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" | grep -q '\.rs$'; then
    HAS_RS=1
    break
  fi
done

[ "$HAS_RS" -eq 0 ] && exit 0

# Use a relative path so the DATABASE_URL works on both Unix and Windows.
# The file lands in the repo root and is covered by *.db in .gitignore.
DB="kani-sqlx-hook-$$.db"
cleanup() { rm -f "$DB"; }
trap cleanup EXIT

echo "Checking sqlx offline query cache..."

if ! DATABASE_URL="sqlite:${DB}?mode=rwc" SQLX_OFFLINE=false cargo sqlx migrate run > /dev/null; then
  echo "error: sqlx migrate run failed"
  exit 1
fi

if ! DATABASE_URL="sqlite:${DB}?mode=rwc" SQLX_OFFLINE=false cargo sqlx prepare --check --workspace -- --all-targets --tests > /dev/null; then
  echo ""
  echo "error: sqlx offline data is out of date"
  echo "       Run: cargo sqlx prepare --workspace -- --all-targets --tests"
  exit 1
fi

echo "sqlx offline data is up to date."
