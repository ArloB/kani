# Rust build artifacts — the builder stage compiles from source
target/

# Git history
.git/
.gitignore

# Pre-downloaded JS vendor files — the builder stage runs fetch-vendors.sh
static/js/vendor/

# TypeScript bindings generated by build.rs (regenerated during build)
static/types/

# Plan / notes / Claude memory
plan.md
.claude/

# Docker files themselves (no need to COPY into the image)
Dockerfile
docker-compose.yml
.dockerignore

# Local development database
*.db
*.db-shm
*.db-wal

# OS noise
.DS_Store
Thumbs.db
