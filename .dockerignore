# Rust build artifacts — the builder stage compiles from source
target/

# Git history
.git/
.gitignore

# Pre-downloaded JS vendor files — the builder stage runs fetch-vendors.sh
static/js/vendor/

# Generated bundles. The builder regenerates both, and esbuild's output is
# content-hashed, so copying a developer's directory in ships every stale chunk
# they have ever built alongside the fresh ones — 483 files locally, ten hashed
# copies of the accounts page among them.
static/js/dist/
static/css/main.css

# TypeScript bindings generated by build.rs (regenerated during build)
static/types/

# Plan / notes / Claude memory
plan.md
.claude/

# Docker files themselves (no need to COPY into the image)
Dockerfile
docker-compose.yml
.dockerignore

# Local development database
*.db
*.db-shm
*.db-wal

# OS noise
.DS_Store
Thumbs.db
