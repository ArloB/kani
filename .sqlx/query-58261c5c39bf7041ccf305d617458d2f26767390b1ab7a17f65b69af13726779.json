  "query": "SELECT c.id, c.name, c.chapter_number, c.volume, c.manga_id, m.name as manga_title, c.downloaded_at\n             FROM chapters c\n             JOIN manga m ON m.id = c.manga_id\n             WHERE c.download_status = 2\n             ORDER BY c.downloaded_at DESC\n             LIMIT ?",
